# Local editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Local agent/operator instructions are not a research artifact.
/AGENTS.md

# Secrets and machine-specific settings
.env
.env.*
!.env.example

# ESP-IDF / PlatformIO / Rust / MicroPython build products
build/
build-mode-b/
cmake-build-*/
.pio/
target/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock.tmp
*.elf
*.bin
*.map
*.o
*.a
*.pyc
__pycache__/

# Exact accepted SHA-256 native binaries are evidence, not disposable builds.
!artifacts/builds/sha256/**/*.elf
!artifacts/builds/sha256/**/*.bin
!artifacts/builds/sha256/**/*.map

# CRC-32 static-analysis evidence is intentionally versioned. These files are
# immutable build artifacts referenced by hashes and provenance manifests.
!artifacts/assembly/crc32/**/*.elf
!artifacts/assembly/crc32/**/*.map
!artifacts/assembly/crc32/**/*.o
!artifacts/assembly/crc32/**/*.obj

# CRC-32 vector representations generated from the pinned upstream source
benchmarks/historical/crc32/test_vectors/v1/generated/
benchmarks/historical/crc32/c/main/generated_vector.hpp
benchmarks/historical/crc32/rust/src/generated_vector.rs
benchmarks/historical/crc32/micropython/generated_vector.py
benchmarks/historical/sha256/test_vectors/v1/generated/
benchmarks/historical/sha256/c/main/generated_vector.hpp
benchmarks/historical/sha256/rust/src/generated_vector.rs
benchmarks/historical/sha256/micropython/generated_vector.py

# MATLAB and generated publication products
*.asv
*.m~
paper/build/
website/public/

# Raw data are intentionally NOT ignored. Never use this file to hide evidence.
.tools/
paper/build/
.reasonix/
